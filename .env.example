# Banco de dados Postgres (Prisma Postgres, provisionado via Storage da Vercel).
# Para usar o docker-compose incluido no lugar, aponte as duas variaveis para:
# postgresql://clubedohobby:clubedohobby@localhost:5432/clubedohobby
CH_STORAGE_DATABASE_URL=
CH_STORAGE_DATABASE_URL_POOLED=

# Bucket para upload de imagens (Vercel Blob). Criado em Storage > Blob na Vercel
# e conectado ao projeto; o token aparece em Settings > Environment Variables.
BLOB_READ_WRITE_TOKEN=

# Chave secreta do Auth.js. Gere uma com: npx auth secret
AUTH_SECRET=

# URL base da aplicacao (em desenvolvimento: http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000
