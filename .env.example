# Banco de dados Postgres. Para desenvolvimento local com o docker-compose incluido, use:
# postgresql://clubedohobby:clubedohobby@localhost:5432/clubedohobby
DATABASE_URL=

# Chave secreta do Auth.js. Gere uma com: npx auth secret
AUTH_SECRET=

# URL base da aplicacao (em desenvolvimento: http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000
